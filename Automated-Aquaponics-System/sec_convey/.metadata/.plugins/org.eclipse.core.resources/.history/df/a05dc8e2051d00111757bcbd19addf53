// sequence.c
// 동작관련
// 트레이 물털고 컨베이어에 올려놓음 -> (uart2(라파)수신받음) -> 두번째 컨베이어 구동 -> ir감지되면 정지 후 직교로봇 z축 내려서 트레이 고정
// -> (uart1(스카라),6(매니퓰레이터)송신함) -> 수확 다 되면 -> (uart수신받음) -> z축 올리고 컨베이어 다시 구동

// 두번째 컨베이어 + Z축 전체 동작 흐름
// 동작 흐름:
//   ST_WAIT_START   : 스카라로부터 S1 수신 대기
//   ST_CONVEY_RUN   : 컨베이어 구동 → IR 감지 대기
//   ST_CONVEY_STOP  : IR 감지 후 정착 딜레이
//   ST_Z_HOMING     : Z축 CW → 리밋스위치 감지 대기
//   ST_WAIT_Z_FIX   : Z축 CCW → 고정 위치 이동 완료 대기
//   ST_SEND_HARVEST : 스카라 + 매니퓰레이터에 H1\n 송신
//   ST_WAIT_HARVEST : 스카라 R1 + 매니퓰레이터 R1 둘 다 수신 대기
//   ST_WAIT_Z_RETURN: Z축 CW 복귀 완료 대기
//   ST_CYCLE_DONE   : 라파에 D1\n 송신 → 초기화
//   ST_ESTOP        : 긴급정지 유지
// ─────────────────────────────────────────────────────────────

#include "sequence.h"
#include "sec_convey.h"
#include "stepper.h"
#include "sensor.h"
#include "comm.h"
#include "stm32f4xx_hal.h"

// 파라미터 (실측 후 수정
#define CONVEY_HZ        3000   // 컨베이어 속도 (step/s)
#define STOP_SETTLE_MS    200   // IR 감지 후 정착 딜레이 (ms)
#define Z_HOMING_HZ      2000   // CW 리밋 탐색 속도 (step/s)
#define Z_FIX_STEPS      2000   // 리밋 후 CCW 고정 스텝 (실측 필요)
#define Z_FIX_HZ         1500   // 고정 이동 속도 (step/s)
#define Z_RETURN_STEPS   2000   // 수확 후 CW 복귀 스텝 (Z_FIX_STEPS와 동일)
#define Z_RETURN_HZ      2000   // 복귀 속도 (step/s)

// 상태 정의
typedef enum {
    ST_WAIT_START,
    ST_CONVEY_RUN,
    ST_CONVEY_STOP,
    ST_Z_HOMING,
    ST_WAIT_Z_FIX,
    ST_SEND_HARVEST,
    ST_WAIT_HARVEST,
    ST_WAIT_Z_RETURN,
	ST_EXIT_CONVEY,
    ST_CYCLE_DONE,
    ST_ESTOP,
} SeqState;

static SeqState g_state = ST_WAIT_START;
static uint32_t settle_start = 0;
static volatile bool z_limit_hit = false;

// EXTI 콜백에서 호출
void Sequence_OnLimitHit(void)
{
    if (!Z_LimitHit()) return;  // 실제 눌림 확인

    if (g_state == ST_Z_HOMING) {
        z_limit_hit = true;
        Z_Stop();
    }
}
// 초기화
void Sequence_Init(void)
{
    Comm_Init();
    g_state     = ST_WAIT_START;
    z_limit_hit = false;
}

// 메인 루프
void App_Run(void)
{
    // 긴급정지 최우선 처리
    if (Comm_IsEstopFlagSet()) {
        Comm_ClearEstopFlag();
        Conveyor_Stop();
        Conveyor_Enable(false);
        Z_Stop();
        Comm_LogToRasp("E1");
        g_state = ST_ESTOP;
    }

    switch (g_state)
    {
        // S1 수신 대기
        case ST_WAIT_START:
            if (Comm_IsStartFlagSet()) {
                Comm_ClearStartFlag();
                Conveyor_Enable(true);
                Conveyor_SetDir(true);
                Conveyor_StartHz(CONVEY_HZ);
                Comm_LogToRasp("C1");   // 라파: 컨베이어 구동
                g_state = ST_CONVEY_RUN;
            }
            break;

        // IR 감지될 때까지 구동
        case ST_CONVEY_RUN:
            if (IR_Detected()) {
                Conveyor_Stop();
                Conveyor_Enable(false);
                settle_start = HAL_GetTick();
                Comm_LogToRasp("I1");   // 라파: IR 감지
                g_state = ST_CONVEY_STOP;
            }
            break;

        // 정착 딜레이 후 Z 호밍 시작
        case ST_CONVEY_STOP:
            if (HAL_GetTick() - settle_start >= STOP_SETTLE_MS) {
                z_limit_hit = false;
                Z_MoveSteps(+1000000, Z_HOMING_HZ);  // CW 리밋 방향
                g_state = ST_Z_HOMING;
            }
            break;

        // 리밋 감지 대기 (EXTI에서 Z_Stop + z_limit_hit = true)
        case ST_Z_HOMING:
            if (z_limit_hit && !Z_IsBusy()) {
                // 리밋 찍은 직후 CCW로 고정 위치 이동
                Z_MoveSteps(-Z_FIX_STEPS, Z_FIX_HZ);
                g_state = ST_WAIT_Z_FIX;
            }
            break;

        // Z 고정 완료 대기
        case ST_WAIT_Z_FIX:
            if (!Z_IsBusy()) {
                Comm_LogToRasp("Z1");   // 라파: Z 고정 완료
                g_state = ST_SEND_HARVEST;
            }
            break;

        // H1 송신
        case ST_SEND_HARVEST:
            Comm_SendHarvest();         // 스카라 + 매니퓰레이터: H1\n
            g_state = ST_WAIT_HARVEST;
            break;

        // 스카라 R1 + 매니퓰레이터 R1 둘 다 올 때까지 대기
        case ST_WAIT_HARVEST:
            if (Comm_IsScaraDoneFlagSet() && Comm_IsManipDoneFlagSet()) {
                Comm_ClearScaraDoneFlag();
                Comm_ClearManipDoneFlag();
                Z_MoveSteps(+Z_RETURN_STEPS, Z_RETURN_HZ);  // CW 복귀
                Comm_LogToRasp("R1");   // 라파: 수확 완료 수신
                g_state = ST_WAIT_Z_RETURN;
            }
            break;

        // Z 복귀 완료 대기
        case ST_WAIT_Z_RETURN:
            if (!Z_IsBusy()) {
                // Z 복귀 완료 → 트레이 배출 시작
                Conveyor_Enable(true);
                Conveyor_SetDir(true);
                Conveyor_StartHz(CONVEY_HZ);
                Comm_LogToRasp("X1");   // 라파: 배출 구동
                g_state = ST_EXIT_CONVEY;
            }
            break;

        // 컨베이어 재구동
        case ST_EXIT_CONVEY:
            // IR이 해제되면 트레이가 완전히 빠져나간 것
            if (!IR_Detected()) {
                Conveyor_Stop();
                Conveyor_Enable(false);
                Comm_LogToRasp("X0");   // 라파: 배출 완료
                g_state = ST_CYCLE_DONE;
            }
            break;

        // 사이클 완료 → 라파에 D1 송신 후 초기화
        case ST_CYCLE_DONE:
            Comm_SendDone();            // 라파: D1\n
            g_state = ST_WAIT_START;
            break;

        // 긴급정지 유지
        case ST_ESTOP:
            break;

        default:
            g_state = ST_WAIT_START;
            break;
    }
}
